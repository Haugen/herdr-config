# Whitelist: Herdr writes and regenerates most of this folder; only my own files are tracked.
# Convention: my layouts and mods are prefixed `my-`.
/*
!/.gitignore
!/README.md
!/settings.json
!/keys.json

!/layouts/
/layouts/*
!/layouts/my-*.json

!/mods/
/mods/*
!/mods/my-*/
# Regenerated by Herdr on every start.
/mods/my-*/*.d.ts
/mods/my-*/jsconfig.json
